# r2: eth0 = primary (100 Mbit/s), eth1 = backup (10 Mbit/s), eth2 = TMS

ip addr add 10.0.1.2/30 dev eth0
ip addr add 10.0.2.2/30 dev eth1
ip addr add 10.0.3.1/24 dev eth2

# [BFD] start bfdd (must be before frr start)
sed -i 's/^bfdd=no/bfdd=yes/' /etc/frr/daemons

chown -R frr:frr /etc/frr
chmod 640 /etc/frr/*.conf
/etc/init.d/frr start

# primary: 100 Mbit/s, 1.25 MB drop-tail FIFO (100 ms)
tc qdisc add dev eth0 root handle 1: htb default 1
tc class add dev eth0 parent 1: classid 1:1 htb rate 100mbit ceil 100mbit
tc qdisc add dev eth0 parent 1:1 handle 10: bfifo limit 1250000

# backup: 10 Mbit/s, 125 kB drop-tail FIFO (100 ms)
tc qdisc add dev eth1 root handle 1: htb default 1
tc class add dev eth1 parent 1: classid 1:1 htb rate 10mbit ceil 10mbit
tc qdisc add dev eth1 parent 1:1 handle 10: bfifo limit 125000